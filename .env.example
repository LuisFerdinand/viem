# Neon Postgres connection string (Neon console → Connection details → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require"

# Public URL of the site, used for Open Graph images, the sitemap and robots.txt.
# Optional on Vercel: falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin panel at /admin — password to sign in (min. 8 characters).
ADMIN_PASSWORD="choose-a-long-password"
# Optional: separate secret for signing the admin cookie (defaults to ADMIN_PASSWORD).
# ADMIN_SESSION_SECRET=""

# Vercel Blob read/write token — needed to upload PDFs from /admin.
# Vercel dashboard → Storage → Blob → create a store → connect to the project (or `vercel env pull`).
BLOB_READ_WRITE_TOKEN=""
